{
  "name": "fobo-terminal",
  "version": "0.1.0",
  "private": true,
  "description": "Chrome extension that gives fomo.family an Axiom-Pulse-style three-column home screen",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "watch": "vite build --watch",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@types/chrome": "^0.2.6",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "typescript": "^5.9.3",
    "vite": "^8.2.1"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.9",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}

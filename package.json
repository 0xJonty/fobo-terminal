{
  "name": "fobo-terminal",
  "version": "1.0.0",
  "private": true,
  "description": "A live three-column token terminal for fomo.family: Bonding, Graduated and Trending side by side, plus alerts, watchlist and feed.",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "watch": "vite build --watch",
    "build": "npm run check && vite build",
    "check": "tsc --noEmit && npm run lint && npm test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts manifest.config.ts vite.config.ts",
    "test": "vitest run",
    "package": "node scripts/package.mjs"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.2.6",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.9",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
